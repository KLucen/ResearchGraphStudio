{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "prompt_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "received",
        "validated",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "raw_output_ref": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Output Ref"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "reported_total_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Total Tokens"
    }
  },
  "required": [
    "id",
    "prompt_id",
    "prompt_version",
    "prompt_sha256",
    "schema_version",
    "input_sha256",
    "model_id",
    "status"
  ],
  "title": "ModelRunRecord",
  "type": "object"
}
