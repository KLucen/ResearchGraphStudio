      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "document_version_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Document Version Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "content": {
      "discriminator": {
        "mapping": {
          "Argument": "#/$defs/ArgumentCandidate",
          "Claim": "#/$defs/ClaimCandidate",
          "Concept": "#/$defs/ConceptCandidate",
          "Condition": "#/$defs/ConditionCandidate",
          "Experiment": "#/$defs/ExperimentCandidate",
          "Finding": "#/$defs/FindingCandidate",
          "Limitation": "#/$defs/LimitationCandidate",
          "Method": "#/$defs/MethodCandidate",
          "Metric": "#/$defs/MetricCandidate",
          "ResearchQuestion": "#/$defs/QuestionCandidate"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ClaimCandidate"
        },
        {
          "$ref": "#/$defs/MethodCandidate"
        },
        {
          "$ref": "#/$defs/ConceptCandidate"
        },
        {
          "$ref": "#/$defs/QuestionCandidate"
        },
        {
          "$ref": "#/$defs/ExperimentCandidate"
        },
        {
          "$ref": "#/$defs/ConditionCandidate"
        },
        {
          "$ref": "#/$defs/FindingCandidate"
        },
        {
          "$ref": "#/$defs/MetricCandidate"
        },
        {
          "$ref": "#/$defs/ArgumentCandidate"
        },
        {
          "$ref": "#/$defs/LimitationCandidate"
        }
      ],
      "title": "Content"
    },
    "source_status": {
      "enum": [
        "anchored",
        "needs_evidence",
        "source_unavailable",
        "invalid_anchor"
      ],
      "title": "Source Status",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "valid",
        "quarantined",
        "superseded"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "legacy_review_status": {
      "anyOf": [
        {
          "enum": [
            "unreviewed",
            "accepted",
            "edited",
            "rejected",
            "superseded"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Review Status"
    },
    "quality": {
      "$ref": "#/$defs/QualityAssessment"
    },
    "model_run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Run Id",
      "type": "string"
    },
    "canonical_id": {
      "anyOf": [
