          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Id"
    }
  },
  "required": [
    "id",
    "document_version_id",
    "revision",
    "content",
    "source_status",
    "validation_status",
    "quality",
    "model_run_id"
  ],
