{
  "$defs": {
    "LintIssue": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Ids",
          "type": "array"
        },
        "issue_type": {
          "enum": [
            "unsupported_core",
            "orphan_member",
            "incorrect_attribution",
            "overgeneralization",
            "duplicate",
            "translation_mismatch",
            "stale_dependency",
            "other"
          ],
          "title": "Issue Type",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "suggested_action": {
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "affected_ids",
        "issue_type",
        "rationale",
        "evidence_ids",
        "suggested_action"
      ],
      "title": "LintIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/$defs/LintIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "issues"
  ],
  "title": "LintIssueBatch",
  "type": "object"
}
