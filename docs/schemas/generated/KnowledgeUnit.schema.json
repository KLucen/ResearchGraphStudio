          "minLength": 1,
          "title": "Member Id",
          "type": "string"
        },
        "association_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Association Ids",
          "type": "array"
        }
      },
      "required": [
        "member_id",
        "association_ids"
      ],
      "title": "UnitMembership",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "document_version_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Document Version Id",
      "type": "string"
    },
    "root_claim_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Root Claim Id",
      "type": "string"
    },
    "revision": {
