{
  "$defs": {
    "GroundedPassage": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Local Ref",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/SourceText"
        },
        "attribution": {
          "enum": [
            "paper_author",
            "citation_report",
            "user_view",
            "model_synthesis"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/VersionedDependency"
          },
          "minItems": 1,
          "title": "Dependencies",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "text",
        "attribution",
        "dependencies"
      ],
      "title": "GroundedPassage",
      "type": "object"
    },
    "SourceText": {
      "additionalProperties": false,
      "description": "Original-language semantic text, not an exact quote or an anchor.",
      "properties": {
        "original": {
          "minLength": 1,
          "title": "Original",
          "type": "string"
        },
        "language": {
          "maxLength": 35,
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "zh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zh"
        }
      },
      "required": [
        "original",
        "language"
      ],
      "title": "SourceText",
      "type": "object"
    },
    "VersionedDependency": {
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_kind": {
          "default": "paper",
          "enum": [
            "paper",
            "note",
            "wiki"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "document_version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        }
      },
      "required": [
        "ref_id",
        "revision"
      ],
      "title": "VersionedDependency",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "scope": {
      "enum": [
        "paper",
        "concept",
        "method",
        "comparison"
      ],
      "title": "Scope",
      "type": "string"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/GroundedPassage"
      },
      "title": "Passages",
      "type": "array"
    },
    "knowledge_revision": {
      "minimum": 0,
      "title": "Knowledge Revision",
      "type": "integer"
    },
    "selection_revision": {
      "minimum": 1,
      "title": "Selection Revision",
      "type": "integer"
    },
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    }
  },
  "required": [
    "title",
    "scope",
    "passages",
    "knowledge_revision",
    "selection_revision",
    "coverage_gaps"
  ],
  "title": "ReadingSynthesisDraft",
  "type": "object"
}
