{
  "$defs": {
    "SelectionHint": {
      "additionalProperties": false,
      "properties": {
        "root_claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Root Claim Id",
          "type": "string"
        },
        "recommendation": {
          "enum": [
            "suggest_core",
            "keep_retrievable",
            "needs_context"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "enum": [
              "main_contribution",
              "answers_paper_question",
              "necessary_limitation",
              "negative_result",
              "redundant",
              "background",
              "insufficient_support",
              "uncertain_attribution"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "root_claim_id",
        "recommendation",
        "reasons",
        "rationale"
      ],
      "title": "SelectionHint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_version_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Document Version Id",
      "type": "string"
    },
    "input_revision": {
      "minimum": 0,
      "title": "Input Revision",
      "type": "integer"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/SelectionHint"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    }
  },
  "required": [
    "document_version_id",
    "input_revision",
    "recommendations"
  ],
  "title": "CoreSelectionProposal",
  "type": "object"
}
