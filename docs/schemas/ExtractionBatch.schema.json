{
  "$defs": {
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "title": "Local Ref",
          "type": "string"
        },
        "statement": {
          "minLength": 10,
          "title": "Statement",
          "type": "string"
        },
        "origin": {
          "enum": [
            "author_claim",
            "authors_experimental_result",
            "authors_hypothesis",
            "cited_claim",
            "background",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "definition",
            "method_claim",
            "empirical_claim",
            "observation",
            "theoretical_claim",
            "limitation",
            "other"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "modality": {
          "enum": [
            "asserted",
            "suggested",
            "conditional",
            "speculative",
            "negated",
            "unknown"
          ],
          "title": "Modality",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "method_local_refs": {
          "items": {
            "type": "string"
          },
          "title": "Method Local Refs",
          "type": "array"
        },
        "experiment_local_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Local Ref"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "statement",
        "origin",
        "claim_type",
        "modality",
        "evidence"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "ConceptDraft": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "title": "Local Ref",
          "type": "string"
        },
        "canonical_name": {
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "canonical_name",
        "evidence_span_ids"
      ],
      "title": "ConceptDraft",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_type": {
          "default": "text",
          "enum": [
            "text",
            "integer",
            "float",
            "boolean"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "known_state": {
          "$ref": "#/$defs/KnownState"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "value",
        "known_state"
      ],
      "title": "Condition",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_span_id": {
          "minLength": 1,
          "title": "Evidence Span Id",
          "type": "string"
        },
        "role": {
          "default": "direct",
          "enum": [
            "direct",
            "context",
            "cited_other",
            "limitation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "evidence_span_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExperimentDraft": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "title": "Local Ref",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "method_local_refs": {
          "items": {
            "type": "string"
          },
          "title": "Method Local Refs",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "label",
        "evidence_span_ids"
      ],
      "title": "ExperimentDraft",
      "type": "object"
    },
    "FindingDraft": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "title": "Local Ref",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "experiment_local_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Local Ref"
        },
        "metric_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Name"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "statement",
        "evidence_span_ids"
      ],
      "title": "FindingDraft",
      "type": "object"
    },
    "KnownState": {
      "enum": [
        "known",
        "unknown",
        "not_applicable",
        "conflicting"
      ],
      "title": "KnownState",
      "type": "string"
    },
    "MethodDraft": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "title": "Local Ref",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanism"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Span Ids",
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "name",
        "evidence_span_ids"
      ],
      "title": "MethodDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/ConceptDraft"
      },
      "title": "Concepts",
      "type": "array"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/MethodDraft"
      },
      "title": "Methods",
      "type": "array"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentDraft"
      },
      "title": "Experiments",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimDraft"
      },
      "title": "Claims",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/FindingDraft"
      },
      "title": "Findings",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    }
  },
  "required": [
    "paper_id",
    "schema_version"
  ],
  "title": "ExtractionBatch",
  "type": "object"
}