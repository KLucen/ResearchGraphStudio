{
  "$defs": {
    "AllowedSpan": {
      "additionalProperties": false,
      "properties": {
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "document_version_id": {
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "text_en": {
          "minLength": 1,
          "title": "Text En",
          "type": "string"
        },
        "page_start": {
          "minimum": 1,
          "title": "Page Start",
          "type": "integer"
        },
        "page_end": {
          "minimum": 1,
          "title": "Page End",
          "type": "integer"
        }
      },
      "required": [
        "span_id",
        "document_version_id",
        "section_id",
        "text_en",
        "page_start",
        "page_end"
      ],
      "title": "AllowedSpan",
      "type": "object"
    },
    "QueryScope": {
      "enum": [
        "selection",
        "section",
        "paper"
      ],
      "title": "QueryScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question": {
      "maxLength": 3000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/QueryScope",
      "default": "section"
    },
    "paper_title": {
      "minLength": 1,
      "title": "Paper Title",
      "type": "string"
    },
    "allowed_spans": {
      "items": {
        "$ref": "#/$defs/AllowedSpan"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Allowed Spans",
      "type": "array"
    },
    "optional_short_card": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Optional Short Card"
    }
  },
  "required": [
    "question",
    "paper_title",
    "allowed_spans"
  ],
  "title": "QAInput",
  "type": "object"
}
