{
  "$defs": {
    "QueryCitation": {
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "supports": {
          "title": "Supports",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "supports"
      ],
      "title": "QueryCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_zh": {
      "title": "Answer Zh",
      "type": "string"
    },
    "answer_en": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer En"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/QueryCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "knowledge_status": {
      "enum": [
        "source_grounded",
        "mixed_sources",
        "insufficient"
      ],
      "title": "Knowledge Status",
      "type": "string"
    },
    "candidate_insights": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Insights",
      "type": "array"
    }
  },
  "required": [
    "answer_zh",
    "knowledge_status"
  ],
  "title": "QueryAnswer",
  "type": "object"
}
