    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "chunk_id": {
      "title": "Chunk Id",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "document_version_id": {
      "title": "Document Version Id",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
