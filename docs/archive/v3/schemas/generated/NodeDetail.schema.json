        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ConditionState"
        },
        "value_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
