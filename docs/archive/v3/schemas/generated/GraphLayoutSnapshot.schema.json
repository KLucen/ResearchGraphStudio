{
  "$defs": {
    "NodeLayout": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        }
      },
      "required": [
        "node_id",
        "x",
        "y"
      ],
      "title": "NodeLayout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "layout_version": {
      "minimum": 1,
      "title": "Layout Version",
      "type": "integer"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/NodeLayout"
      },
      "title": "Positions",
      "type": "array"
    },
    "zoom": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Zoom",
      "type": "number"
    },
    "pan_x": {
      "default": 0,
      "title": "Pan X",
      "type": "number"
    },
    "pan_y": {
      "default": 0,
      "title": "Pan Y",
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "view_id",
    "layout_version",
    "positions"
  ],
  "title": "GraphLayoutSnapshot",
  "type": "object"
}
