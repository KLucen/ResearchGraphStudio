{
  "$defs": {
    "ClaimDetail": {
      "additionalProperties": false,
      "properties": {
        "statement_en": {
          "minLength": 1,
          "title": "Statement En",
          "type": "string"
        },
        "statement_zh": {
          "minLength": 1,
          "title": "Statement Zh",
          "type": "string"
        },
        "modality": {
          "enum": [
            "asserted",
            "conditional",
            "suggested",
            "speculative",
            "negated",
            "unknown"
          ],
          "title": "Modality",
          "type": "string"
        },
        "scope_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope En"
        },
        "scope_zh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Zh"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/ConditionCandidate"
          },
          "title": "Conditions",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingCandidate"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "statement_en",
        "statement_zh",
        "modality"
      ],
      "title": "ClaimDetail",
      "type": "object"
    },
    "ConditionCandidate": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ConditionState"
        },
        "value_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value En"
        },
        "value_zh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Zh"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "state"
      ],
      "title": "ConditionCandidate",
      "type": "object"
    },
    "ConditionState": {
      "enum": [
        "known",
        "unknown",
        "not_applicable",
        "conflicting"
      ],
      "title": "ConditionState",
      "type": "string"
    },
    "ExtractedNode": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "title": "Local Ref",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "label_zh": {
          "minLength": 1,
          "title": "Label Zh",
          "type": "string"
        },
        "label_en": {
          "minLength": 1,
          "title": "Label En",
          "type": "string"
        },
        "summary_zh": {
          "minLength": 1,
          "title": "Summary Zh",
          "type": "string"
        },
        "summary_en": {
          "minLength": 1,
          "title": "Summary En",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/KnowledgeOrigin"
        },
        "claim_detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
