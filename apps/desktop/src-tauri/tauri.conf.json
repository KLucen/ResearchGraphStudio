{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchGraph Studio",
  "version": "0.0.1",
  "identifier": "com.researchgraph.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ResearchGraph Studio","width":1280,"height":850,"minWidth":950,"minHeight":680}],
    "security": {"csp":"default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/researchgraph-engine"],
    "resources": {"binaries/_internal/":"_internal/"},
    "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type":"downloadBootstrapper","silent":true},
      "nsis": {"installMode":"currentUser","languages":["SimpChinese","English"],"displayLanguageSelector":false}
    }
  }
}
